{
  "name": "portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc -p server/tsconfig.json",
    "test": "vitest run",
    "server": "tsx server/src/node.ts",
    "demo": "cross-env VITE_API_URL=same-origin npm run build && tsx server/src/node.ts",
    "db:init": "wrangler d1 execute portfolio --remote --file server/schema.sql",
    "deploy": "cross-env VITE_API_URL=same-origin npm run build && wrangler deploy",
    "test:e2e": "node e2e/site.mjs"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/howler": "^2.2.13",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2",
    "@types/react-dom": "19.2",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "otpauth": "^9.5.2",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "canvas-confetti": "^1.9.4",
    "cmdk": "^1.1.1",
    "hono": "^4.13.8",
    "howler": "^2.2.4",
    "input-otp": "^1.5.0",
    "libphonenumber-js": "^1.13.13",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2",
    "react-dom": "19.2",
    "react-hook-form": "^7.88.0",
    "react-router-dom": "^7.18.4",
    "simple-icons": "^16.31.0",
    "sonner": "^2.0.8",
    "three": "^0.186.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  }
}
