{
  "name": "portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "backend:up": "docker compose -f supabase/local/docker-compose.yml up -d && node -e \"setTimeout(()=>{},8000)\" && docker compose -f supabase/local/docker-compose.yml exec -T db psql -U postgres -q -v ON_ERROR_STOP=1 -f - < supabase/migrations/0001_init.sql",
    "backend:down": "docker compose -f supabase/local/docker-compose.yml down -v",
    "test:backend": "node supabase/local/test-backend.mjs",
    "test:e2e": "node e2e/site.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/howler": "^2.2.13",
    "@types/react": "19.2",
    "@types/react-dom": "19.2",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "otpauth": "^9.5.2",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@supabase/supabase-js": "^2.116.0",
    "canvas-confetti": "^1.9.4",
    "cmdk": "^1.1.1",
    "howler": "^2.2.4",
    "input-otp": "^1.5.0",
    "libphonenumber-js": "^1.13.13",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "radix-ui": "^1.6.7",
    "react": "19.2",
    "react-dom": "19.2",
    "react-hook-form": "^7.88.0",
    "react-router-dom": "^7.18.4",
    "simple-icons": "^16.31.0",
